# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas (leave empty to use in-memory dev database)
MONGO_URI=

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Cloudinary (optional — file uploads fall back to base64 if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Daily.co (optional — peer/live interview video rooms; mock URLs used if unset)
DAILY_API_KEY=your_daily_api_key_here

# Judge0 via RapidAPI (optional — code execution; returns "No Key" status if unset)
JUDGE0_API_KEY=your_judge0_rapidapi_key_here

# Resend (optional — emails are logged to console if unset)
RESEND_API_KEY=
